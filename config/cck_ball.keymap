#define ZMK_POINTING_DEFAULT_MOVE_VAL 800
#define ZMK_POINTING_DEFAULT_SCRL_VAL 1

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "private.dtsi"

&mmv_input_listener { input-processors = <&zip_xy_scaler 1 1>; #sensor-binding-cells = <0>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 1 1>; };

&msc { acceleration-exponent = <0>; time-to-max-speed-ms = <300>; delay-ms = <0>; };
&mmv { time-to-max-speed-ms = <2000>; acceleration-exponent = <0>; trigger-period-ms = <16>; };

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_enc: scroll_enc {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
    };

    hscroll_enc: hscroll_enc {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;
    };

    combos {
        compatible = "zmk,combos";

        combo_selword   { timeout-ms = <35>;  key-positions = <3  5 >;    bindings = <&sel_word>;   };
        combo_enter_spc { timeout-ms = <35>;  key-positions = <29 41>;    bindings = <&kp RET>;     };
        combo_bspc      { timeout-ms = <35>;  key-positions = <17 41>;    bindings = <&kp BSPC>;    };
        combo_del       { timeout-ms = <35>;  key-positions = <5  41>;    bindings = <&kp DEL>;     };
        combo_space     { timeout-ms = <35>;  key-positions = <30 42>;    bindings = <&kp SPACE>;   };
        combo_caps      { timeout-ms = <35>;  key-positions = <24 25 26>; bindings = <&caps_word>;  };
        combo_app       { timeout-ms = <35>;  key-positions = <30 31>;    bindings = <&kp K_APP>;   layers = <0>; };
        combo_soft_off  { timeout-ms = <200>; key-positions = <30 31>;    bindings = <&soft_off>;   layers = <2>; };

        combo_comma { timeout-ms = <35>; key-positions = <14 27>; bindings = <&kp COMMA>; };
        combo_dot   { timeout-ms = <35>; key-positions = <15 28>; bindings = <&kp DOT>;   };
        combo_semi  { timeout-ms = <35>; key-positions = <16 29>; bindings = <&kp SEMI>;  };

        combo_lbrc { timeout-ms = <35>; key-positions = <0  1 >; bindings = <&kp LBKT>; };
        combo_rbrc { timeout-ms = <35>; key-positions = <0  2 >; bindings = <&kp RBKT>; };
        combo_lcbr { timeout-ms = <35>; key-positions = <0 13>;  bindings = <&kp LBRC>;  };
        combo_rcbr { timeout-ms = <35>; key-positions = <0 14>;  bindings = <&kp RBRC>;  };
        combo_lprn { timeout-ms = <35>; key-positions = <0 25>;  bindings = <&kp LPAR>;  };
        combo_rprn { timeout-ms = <35>; key-positions = <0 26>;  bindings = <&kp RPAR>;  };

        combo_slash    { timeout-ms = <35>; key-positions = <4  15 26>; bindings = <&kp FSLH>;  };
        combo_bslash   { timeout-ms = <35>; key-positions = <2  15 28>; bindings = <&kp BSLH>;  };
        combo_pipe     { timeout-ms = <35>; key-positions = <3  15 27>; bindings = <&kp PIPE>;  };
        combo_caret    { timeout-ms = <35>; key-positions = <3  14 16>; bindings = <&kp CARET>; };
        combo_lt       { timeout-ms = <35>; key-positions = <3  14 27>; bindings = <&kp LT>;    };
        combo_gt       { timeout-ms = <35>; key-positions = <3  16 27>; bindings = <&kp GT>;    };
        combo_grave    { timeout-ms = <35>; key-positions = <4  17>;    bindings = <&kp GRAVE>;  };
        combo_tilde    { timeout-ms = <35>; key-positions = <1  16>;    bindings = <&kp TILDE>;  };
        combo_quote    { timeout-ms = <35>; key-positions = <2  4 >;    bindings = <&kp SQT>;    };
        combo_acute      { timeout-ms = <35>; key-positions = <4  15>; bindings = <&kp RA(E)>;   };
        combo_dead_acute { timeout-ms = <35>; key-positions = <5  16>; bindings = <&kp RA(E)>;   };
        combo_hash     { timeout-ms = <35>; key-positions = <3  4  5 >; bindings = <&kp HASH>;  };
        combo_perc     { timeout-ms = <35>; key-positions = <2  28>;    bindings = <&kp PRCNT>;  };
        combo_excl     { timeout-ms = <35>; key-positions = <2  3  16>; bindings = <&kp EXCL>;  };
        combo_ques     { timeout-ms = <35>; key-positions = <4  14 15>; bindings = <&kp QMARK>; };
        combo_dollar   { timeout-ms = <35>; key-positions = <16 26 27>; bindings = <&kp DLLR>;  };
        combo_at       { timeout-ms = <35>; key-positions = <2  15 16>; bindings = <&kp AT>;    };
        combo_amp      { timeout-ms = <35>; key-positions = <15 17>;    bindings = <&kp AMPS>;   };
        combo_star     { timeout-ms = <35>; key-positions = <27 28 29>; bindings = <&kp STAR>;  };
        combo_equal    { timeout-ms = <35>; key-positions = <4  5 >;    bindings = <&kp EQUAL>;  };
        combo_minus    { timeout-ms = <35>; key-positions = <16 17>;    bindings = <&kp MINUS>;  };
        combo_under    { timeout-ms = <35>; key-positions = <28 29>;    bindings = <&kp UNDER>;  };
        combo_plus     { timeout-ms = <35>; key-positions = <15 16 17>; bindings = <&kp PLUS>;  };
        combo_comment  { timeout-ms = <35>; key-positions = <15 16 26>; bindings = <&dev_comment>; };

        combo_tilde_a { timeout-ms = <35>; key-positions = <13 26>; bindings = <&accent_a>; };
        combo_tilde_e { timeout-ms = <50>; key-positions = <3  16>; bindings = <&accent_e>; };
        combo_tilde_i { timeout-ms = <35>; key-positions = <8  19>; bindings = <&accent_i>; };
        combo_tilde_o { timeout-ms = <35>; key-positions = <9  20>; bindings = <&accent_o>; };
        combo_tilde_u { timeout-ms = <35>; key-positions = <7  18>; bindings = <&accent_u>; };
        combo_enie    { timeout-ms = <35>; key-positions = <19 30>; bindings = <&accent_n>; };

        combo_mouse_lclk_l { timeout-ms = <35>; key-positions = <5  17>; bindings = <&mkp LCLK>; };
        combo_mouse_rclk_l { timeout-ms = <35>; key-positions = <17 29>; bindings = <&mkp RCLK>; };
        combo_mouse_mclk_l { timeout-ms = <35>; key-positions = <17 28>; bindings = <&mkp MCLK>; };
        combo_mouse_lclk_r { timeout-ms = <35>; key-positions = <18 19>; bindings = <&mkp LCLK>; };
        combo_mouse_rclk_r { timeout-ms = <35>; key-positions = <19 20>; bindings = <&mkp RCLK>; };
        combo_mouse_mclk_r { timeout-ms = <35>; key-positions = <18 20>; bindings = <&mkp MCLK>; };
        combo_mouse_back_r { timeout-ms = <35>; key-positions = <18 31>; bindings = <&mkp MB4>;   };
        combo_mouse_fwd_r  { timeout-ms = <35>; key-positions = <6  19>; bindings = <&mkp MB5>;   };

        combo_desk_left  { timeout-ms = <50>; key-positions = <3  13   >; bindings = <&kp LC(LEFT)>;  };
        combo_desk_right { timeout-ms = <50>; key-positions = <1  15   >; bindings = <&kp LC(RIGHT)>; };
        combo_desk_up    { timeout-ms = <50>; key-positions = <2  13 15>; bindings = <&kp LC(UP)>;    };

        combo_snipe_tog  { timeout-ms = <50>; key-positions = <27 29>; bindings = <&mo 4>; };

        combo_email_gmail { timeout-ms = <50>; key-positions = <13 14 15 16>; bindings = <&macro_email_gmail>; };
        combo_email_work  { timeout-ms = <50>; key-positions = <18 19 20 21>; bindings = <&macro_email_work>;  };
        combo_username    { timeout-ms = <50>; key-positions = <4  7  14  >;  bindings = <&macro_username>;    };
        combo_password    { timeout-ms = <50>; key-positions = <2  10     >;  bindings = <&macro_password>;    };
    };

    behaviors {
        td_colon: td_colon {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp SEMI>, <&kp COLON>;
        };

        td_quote: td_quote {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp SQT>, <&kp DQT>, <&kp AT>;
        };

        paranthesis_dance: paranthesis_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&ocpar>, <&kp LPAR>, <&kp RPAR>;
        };

        curl_dance: curl_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&occurl>, <&kp LBRC>, <&kp RBRC>;
        };

        squ_dance: squ_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&ocsqu>, <&kp LBKT>, <&kp RBKT>;
        };

        ang_dance: ang_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&ocang>, <&kp LT>, <&kp GT>;
        };

        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        ocpar:  ocpar  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&macro_tap>, <&kp LPAR &kp RPAR &kp LEFT_ARROW>; };
        occurl: occurl { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&macro_tap>, <&kp LBRC &kp RBRC &kp LEFT_ARROW>; };
        ocsqu:  ocsqu  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&macro_tap>, <&kp LBKT &kp RBKT &kp LEFT_ARROW>; };
        ocang:  ocang  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&macro_tap>, <&kp LT   &kp GT   &kp LEFT_ARROW>; };

        sel_word: sel_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp LCTRL &kp LSHFT &kp RIGHT>, <&macro_release>, <&kp LCTRL &kp LSHFT>;
        };

        dev_home: dev_home { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LG(LEFT)>;  };
        dev_end:  dev_end  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LG(RIGHT)>; };

        wd_left: wd_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp LCTRL &kp LEFT>, <&macro_release>, <&kp LCTRL>;
        };

        wd_rght: wd_rght {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp LCTRL &kp RIGHT>, <&macro_release>, <&kp LCTRL>;
        };

        dev_comment: dev_comment {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp LCTRL &kp FSLH>, <&macro_release>, <&kp LCTRL>;
        };

        win_swap: win_swap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp LALT &kp TAB>, <&macro_release>, <&kp LALT>;
        };

        accent_a: accent_a { compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <50>; tap-ms = <40>; bindings = <&kp RA(E) &kp A>; };
        accent_e: accent_e { compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <50>; tap-ms = <40>; bindings = <&kp RA(E) &kp E>; };
        accent_i: accent_i { compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <50>; tap-ms = <40>; bindings = <&kp RA(E) &kp I>; };
        accent_o: accent_o { compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <50>; tap-ms = <40>; bindings = <&kp RA(E) &kp O>; };
        accent_u: accent_u { compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <50>; tap-ms = <40>; bindings = <&kp RA(E) &kp U>; };
        accent_n: accent_n { compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <50>; tap-ms = <40>; bindings = <&kp RA(N) &kp N>; };
    };

    keymap {
        compatible = "zmk,keymap";

            // ── Posiciones CCK-BALL (48 teclas) ───────────────────────────────────
    // Fila 0:  0=TAB  1=Q   2=W   3=E   4=R   5=T  |  6=Y   7=U   8=I   9=O  10=P  11=BSPC
    // Fila 1: 12=ESC 13=A  14=S  15=D  16=F  17=G  | 18=H  19=J  20=K  21=L  22=;  23='"
    // Fila 2: 24=LSH 25=Z  26=X  27=C  28=V  29=B  | 30=N  31=M  32=,  33=.  34=UP 35=/
    // Fila 3: 36=CTL 37=MO2 38=ALT 39=CMD 40=MO1 41=SPC | 42=ENT 43=MO1r 44=MO2r 45=← 46=↓ 47=→
    //
    // Thumbs (equiv. Corne):  SPC(40) MO1(41) | MO2(42) ENT(43)
    // Extras CCK-BALL (cmd):  CTL(36) WIN(37) ALT(38) | RALT(44) ←(45) ↓(46) →(47)

        QWERTY {
            bindings = <
&kp ESC     &kp Q    &kp W    &kp E  &kp R  &kp T        &kp Y      &kp U       &kp I         &kp O         &kp P      &bspc_del
&kp TAB     &kp A    &kp S    &kp D  &kp F  &kp G        &hm RGUI H &hm RALT J  &hm RCTRL K   &hm RSHFT L   &td_colon  &td_quote
&kp LSHIFT  &kp Z    &kp X    &kp C  &kp V  &kp B        &kp N      &kp M       &kp LG(GRAVE) &kp HOME      &kp UP     &kp END
&kp LCTRL   &mo 2    &kp LALT &kp LCMD   &mo 1  &lt 5 SPACE  &kp ENTER  &mo 1       &sl 2         &kp LEFT      &kp DOWN   &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp DOWN UP &hscroll_enc>;
        };

        NAV_NUM {
            bindings = <
&kp LC(LEFT) &kp HOME  &kp UP    &kp END    &kp LC(RIGHT) &kp KP_NUM      &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp COMMA &sk LGUI &sk LALT
&none        &kp LEFT  &kp DOWN  &kp RIGHT  &none         &kp LG(TAB)     &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp DOT   &sk LSFT &sk LCTL
&trans       &dev_home &trans    &dev_end   &none         &kp LG(LS(TAB)) &kp KP_N1 &kp KP_N2 &kp KP_N3 &trans    &trans   &trans
&trans       &trans    &trans    &none      &trans        &trans          &kp INS   &trans    &kp KP_N0 &trans    &trans   &trans
            >;
            sensor-bindings = <&scroll_enc &hscroll_enc>;
        };

        NUM_FN {
            bindings = <
&none   &kp N7  &kp N8  &kp N9  &none  &kp KP_NUM  &kp F1           &kp F2  &kp F3  &kp F4   &kp F5   &kp F6
&none   &kp N4  &kp N5  &kp N6  &none  &kp PSCRN   &kp F7           &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &kp N1  &kp N2  &kp N3  &none  &mo 3       &kp PAUSE_BREAK  &none   &none   &trans   &none    &none
&trans  &trans  &kp N0  &none   &none  &none       &kp KP_ENTER     &none   &none   &trans   &trans   &trans
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &hscroll_enc>;
        };

        BT_layers {
            bindings = <
&bootloader &none          &none       &none  &none  &none       &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_SEL 5
&none       &bt BT_CLR_ALL &bt BT_CLR  &none  &none  &bt BT_PRV  &none        &none        &none        &none        &none        &none
&none       &none          &none       &none  &none  &bt BT_NXT  &none        &none        &none        &none        &none        &none
&none       &none          &none       &none  &none  &none       &none        &none        &none        &none        &none        &bootloader
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &hscroll_enc>;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&mmv_input_listener>;
        };

        MIRROR {
            bindings = <
&trans  &kp Y  &kp U  &kp I      &kp O    &kp P       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp H  &kp J  &kp K      &kp L    &kp SEMI    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp N  &kp M  &kp COMMA  &kp DOT  &kp K_LOCK  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans &trans &trans     &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
